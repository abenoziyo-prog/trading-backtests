# Copy to deploy/nq_paper_bot.env (or the project's .env), fill in, then: chmod 600 deploy/nq_paper_bot.env
# Schwab developer app (developer.schwab.com). Data only: the bot never sends orders.
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=/home/ubuntu/trading-backtests/state/nqbot/schwab_token.json

# Front-month alias; if Schwab rejects it, use the dated contract (e.g. /NQZ26) and update it at each quarterly roll.
NQBOT_SYMBOL=/NQ
NQBOT_STATE_DIR=/home/ubuntu/trading-backtests/state/nqbot

# Alerts (free; set any or all). ntfy: install the ntfy app and subscribe to the same hard-to-guess topic.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
