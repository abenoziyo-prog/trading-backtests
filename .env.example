# Copy to .env and fill in. Never commit .env.

# Alpaca: free paper account at https://app.alpaca.markets (Paper account > API Keys).
# Used for 1-minute stock/ETF history and the paper-trading bot.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Keep true for paper trading. Live trading needs ALPACA_PAPER=false AND --live.
ALPACA_PAPER=true

# Databento: https://databento.com/signup (new accounts get free credit).
# Used for CME futures (NQ, ES) 1-minute history.
DATABENTO_API_KEY=
