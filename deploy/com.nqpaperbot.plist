<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS alternative to the server: run the bot on this Mac at login and keep it alive.
       cp deploy/com.nqpaperbot.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.nqpaperbot.plist
     The Mac must stay awake and online (System Settings > Battery/Energy: prevent automatic sleeping). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nqpaperbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . /Users/ari/trading-backtests/deploy/nq_paper_bot.env; exec /Users/ari/trading-backtests/.venv/bin/python /Users/ari/trading-backtests/bots/nq_paper_bot.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ari/trading-backtests</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/ari/trading-backtests/state/nqbot/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/ari/trading-backtests/state/nqbot/launchd.err.log</string>
</dict>
</plist>
