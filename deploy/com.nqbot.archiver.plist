<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily Schwab 1-minute archiver (/NQ, QQQ), run on this Mac at 02:00 local time (after the US close in New York).
       cp deploy/com.nqbot.archiver.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.nqbot.archiver.plist
     If the Mac is asleep at 02:00, launchd runs it once on wake. Remove with launchctl unload + rm.
     Schwab keeps ~6 weeks of 1-minute bars, so missed days are filled in on the next run. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nqbot.archiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . /Users/ari/trading-backtests/deploy/nq_paper_bot.env; exec /Users/ari/trading-backtests/.venv/bin/python /Users/ari/trading-backtests/bots/schwab_archiver.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ari/trading-backtests</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/ari/trading-backtests/data/schwab/archiver.out.log</string>
  <key>StandardErrorPath</key><string>/Users/ari/trading-backtests/data/schwab/archiver.err.log</string>
</dict>
</plist>
