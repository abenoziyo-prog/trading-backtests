# Copy to .env and fill in. Never commit .env.

# Alpaca: free paper account at https://app.alpaca.markets (Paper account > API Keys).
# Used for 1-minute stock/ETF history (scripts/download_minute.py).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Databento: https://databento.com/signup (new accounts get free credit).
# Used for CME futures (NQ, ES) 1-minute history.
DATABENTO_API_KEY=

# Schwab developer app (developer.schwab.com > Dashboard > your app): the thinkorswim / Schwab market-data API.
# Used locally by bots/schwab_login.py and bots/gex_snapshot.py (docs/LOCAL_GEX.md). Data only: no orders.
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
# Must match the callback URL registered on the app, character for character.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
